<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2A7C"
        android:padding="16dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktywność 1 - Konfigurator"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurator Pizzy"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autor: Kacper Dondzik"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wybierz rozmiar:"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgRozmiar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <RadioButton
                    android:id="@+id/rbMala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mała 25 zł" />
                <RadioButton
                    android:id="@+id/rbSrednia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Średnia 35 zł"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/rbDuza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duża 45 zł" />
            </RadioGroup>


            <CheckBox
                android:id="@+id/cbGrubeCiasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grube ciasto (+5 zł)"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liczba sztuk:"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>


            <EditText
                android:id="@+id/etSztuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1"
                android:inputType="number"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnDalej"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRZEJDŹ DO PODSUMOWANIA"
                android:backgroundTint="#1F2A7C"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="12dp"/>





        </LinearLayout>
    </ScrollView>

</LinearLayout>